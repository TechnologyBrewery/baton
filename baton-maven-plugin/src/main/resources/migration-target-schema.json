{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "#group",
  "title": "Group",
  "anyOf": [
    {
      "$ref": "#/definitions/group"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/definitions/group"
      }
    }
  ],
  "definitions": {
    "group":{
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "migrations"],
        "properties": {
            "group": {
                "type": "string"
            },
            "migrations": {
                "type": "array",
                "items": {
                    "$ref": "#/definitions/migration"
                }
            }
        }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "implementation": {
          "type": "string"
        },
        "fileSets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fileSet": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "directory": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "includes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "excludes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "followSymLinks": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        }
      },
      "required": [
        "name",
        "implementation"
      ]
    }
  }
}