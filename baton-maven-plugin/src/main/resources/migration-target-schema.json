{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Group",
    "anyOf": [
      {
        "$ref": "#/definitions/group_ordered"
      },
      {
        "$ref": "#/definitions/group_versioned"
      },
      {
        "type": "array",
        "items": {
            "anyOf": [
                {
                    "$ref": "#/definitions/group_ordered"
                }, 
                {
                    "$ref": "#/definitions/group_versioned"
                }
            ]
        }
      }
    ],
    "definitions": {
      "group_ordered":{
          "type": "object",
          "additionalProperties": false,
          "required": ["group", "migrations", "type"],
          "properties": {
              "group": {
                  "type": "string"
              },
              "type": {
                  "enum": ["ordered"]
              },
              "migrations": {
                  "type": "array",
                  "items": {
                      "$ref": "#/definitions/migration_ordered"
                  }
              }
          }
      },
      "migration_ordered": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "implementation": {
            "type": "string"
          }, 
          "fileSets": {
              "$ref": "#/definitions/fileSets"
          }
        },
        "required": [
          "name",
          "implementation"
        ]
      }, 
      "group_versioned":{
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "migrations", "type"],
        "properties": {
            "group": {
                "type": "string"
            },
            "type": {
                "enum": ["versioned"]
            },
            "migrations": {
                "type": "array",
                "items": {
                    "$ref": "#/definitions/migration_versioned"
                }
            }
        }
    },
    "migration_versioned": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
            "pattern": "\\d+\\.\\d+\\.\\d+"
        },
        "implementation": {
          "type": "string"
        }, 
        "fileSets": {
            "$ref": "#/definitions/fileSets"
        }
      },
      "required": [
        "name",
        "implementation", 
        "version"
      ]
    }, 
      "fileSets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fileSet": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "directory": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "includes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "excludes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "followSymLinks": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
  }